<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" /> <!-- Foreground service permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" /> <!-- New permission for location-based foreground services in Android 14 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Meal_Mission_App"
        tools:targetApi="31">
        <meta-data
            android:name="com.google.android.actions"
            android:resource="@drawable/rounded_button" />
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCyNQXSZN-qOP__Xu15JCqPIQVQUHjZN5k" />
        <activity
            android:name=".pages.LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Customer pages -->

        <activity
            android:name=".pages.customer.CustomerActivityCustomer"
            android:exported="true"
            android:label="Customer"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".pages.customer.CustomerHomepageActivityCustomer"
            android:exported="true"
            android:label="CustomerHomepage"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".pages.customer.CartActivityCustomer"
            android:exported="true"
            android:label="CustomerHomepage"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar" />
        <activity
            android:name=".pages.customer.CustomerOrdersActivityCustomer"
            android:exported="true"
            android:label="CustomerOrderListActivity"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar" />
        <activity
            android:name=".pages.customer.CustomerOrderDetailsActivity"
            android:exported="true"
            android:label="CustomerOrderDetailsActivity"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar" />
        <activity
            android:name=".pages.customer.PaymentActivity"
            android:exported="true"
            android:label="CustomerHomepage"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".pages.customer.RestaurantDetailsActivityCustomer"
            android:exported="true"
            android:label="RestaurantDetails"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar" />
        <activity
            android:name=".pages.customer.ProfileActivityCustomer"
            android:exported="true"
            android:label="RestaurantDetails"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar" />

        <!-- Driver pages -->
        <activity
            android:name=".pages.driver.DriverProfileActivity"
            android:exported="true"
            android:label="Customer"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <activity
            android:name=".pages.driver.DriverHomePageActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".pages.driver.DriverOrderDetailsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".pages.driver.DriverOrderListActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />


        <!-- Restaurant pages -->
        <activity
            android:name=".pages.restaurant.RestaurantOrderListActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".pages.restaurant.RestaurantOrderDetailsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar" />
        <activity
            android:name=".pages.restaurant.RestaurantProfileActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar" />


        <service
            android:name=".services.LocationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <service
            android:name=".services.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
    </application>

</manifest>