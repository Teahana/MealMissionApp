<!-- res/drawable/login_button.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF6200EE"/> <!-- Color when pressed -->
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#A1D6B2"
                android:endColor="#CEDF9F"
                android:angle="45"/> <!-- Gradient background -->
            <corners android:radius="8dp"/>
            <stroke
                android:width="2dp"
                android:color="#F1F3C2"/> <!-- Border color -->
        </shape>
    </item>
</selector>
