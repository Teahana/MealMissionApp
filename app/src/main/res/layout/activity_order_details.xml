<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- Header with Logo Image -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp">

        <ImageView
            android:id="@+id/logo_image"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:src="@drawable/logo/logo" />
    </LinearLayout>

    <!-- Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Order Details Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/cart_order_group_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <!-- Order ID and Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="space_between">

                    <TextView
                        android:id="@+id/textViewOrderId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:id="@+id/textViewOrderStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@android:color/black" />
                </LinearLayout>

                <!-- Order Date and Time -->
                <TextView
                    android:id="@+id/textViewOrderDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:textColor="@android:color/darker_gray" />

                <!-- Customer Info -->
                <TextView
                    android:id="@+id/textViewCustomerInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="14sp"
                    android:textColor="@android:color/black" />

                <!-- Meal Price -->
                <TextView
                    android:id="@+id/textViewMealPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:textColor="@android:color/black" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/cart_divider"
                    android:layout_marginVertical="8dp" />

                <!-- Order Meals Title -->
                <TextView
                    android:id="@+id/textViewOrderMealsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order Meals:"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:textSize="16sp"
                    android:textColor="@android:color/black" />

                <!-- Order Meals -->
                <TextView
                    android:id="@+id/textViewOrderMeals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:textColor="@android:color/black" />

                <!-- Order Items Title -->
                <TextView
                    android:id="@+id/textViewOrderItemsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order Items:"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:textSize="16sp"
                    android:textColor="@android:color/black" />

                <!-- Order Items -->
                <TextView
                    android:id="@+id/textViewOrderItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/buttonAcceptOrder"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Accept Order"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:background="@drawable/cart_payment_button"
                    android:layout_marginTop="16dp" />

                <Button
                    android:id="@+id/buttonOrderReady"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Order Ready"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:background="@drawable/cart_payment_button"
                    android:layout_marginTop="8dp"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
