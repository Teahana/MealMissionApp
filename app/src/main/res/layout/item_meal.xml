<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mealContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- Meal Card -->
    <LinearLayout
        android:id="@+id/mealCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/button_orange"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="8dp">

        <!-- Meal Name -->
        <TextView
            android:id="@+id/mealName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meal Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <!-- Meal Description -->
        <TextView
            android:id="@+id/mealDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meal Description"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="4dp" />

        <!-- Meal Price -->
        <TextView
            android:id="@+id/mealPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="4dp" />

        <!-- Quantity Adjustment and Add to Cart -->
        <LinearLayout
            android:id="@+id/quantityAddToCartLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <!-- Quantity Adjustment Layout -->
            <LinearLayout
                android:id="@+id/quantityLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Decrease Button -->
                <Button
                    android:id="@+id/decreaseQuantityButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="-"
                    android:textSize="24sp"
                    android:textColor="@android:color/black"
                    android:background="@drawable/button_green" />

                <!-- Quantity Display -->
                <TextView
                    android:id="@+id/mealQuantityText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:gravity="center"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp" />

                <!-- Increase Button -->
                <Button
                    android:id="@+id/increaseQuantityButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="+"
                    android:textSize="24sp"
                    android:textColor="@android:color/black"
                    android:background="@drawable/button_green" />
            </LinearLayout>

            <!-- Add to Cart Button -->
            <Button
                android:id="@+id/addToCartButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="Add to Cart"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:background="@drawable/button_green"
                android:layout_weight="1"
                android:layout_marginLeft="16dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
