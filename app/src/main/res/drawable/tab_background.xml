<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- State when the tab is pressed (clicked) -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@android:color/transparent" />
            <padding android:bottom="4dp"/>
            <stroke android:width="2dp"  android:color="@android:color/transparent"/>
        </shape>
    </item>

    <!-- State when the tab is hovered over (for mouse/stylus) -->
    <item android:state_hovered="true">
        <shape>
            <solid android:color="@android:color/transparent" />
            <padding android:bottom="4dp"/>
            <stroke android:width="2dp" android:color="@android:color/transparent"/>
        </shape>
    </item>

    <!-- Default state for the tab -->
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="0dp" android:color="@android:color/transparent"/>
        </shape>
    </item>
</selector>
