<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF"> <!-- Set background color -->

    <!-- Header Part for Image Logo -->
    <ImageView
        android:id="@+id/logo_image"
        android:layout_width="179dp"
        android:layout_height="179dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:contentDescription="Logo"
        android:src="@drawable/logo" />

    <!-- Big Label for Meal Mission -->
    <TextView
        android:id="@+id/meal_mission_label"
        android:layout_width="365dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="Meal Mission"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Label for Username -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Username"
        android:fontFamily="sans-serif"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"/>

    <!-- Username EditText styled like a default HTML text box -->
    <EditText
        android:id="@+id/username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your username"
        android:fontFamily="sans-serif"
        android:padding="10dp"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/editbox_background" />

    <!-- Label for Password -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Password"
        android:fontFamily="sans-serif"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <!-- Password EditText styled like a default HTML text box -->
    <EditText
        android:id="@+id/password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your password"
        android:inputType="textPassword"
        android:fontFamily="sans-serif"
        android:padding="10dp"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/editbox_background" />

    <!-- Login Button with rounded corners -->
    <Button
        android:id="@+id/login_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="60dp"
        android:background="@drawable/rounded_button"
        android:textColor="#FFFFFF"
        android:padding="12dp"
    />
    <Button
        android:id="@+id/customer_login_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login as Customer"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/driver_login_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login as Driver"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/restaurant_login_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login as Restaurant"
        android:layout_marginTop="8dp" />


</LinearLayout>